{
  "name": "dsh-samrt-subagent",
  "version": "0.1.0",
  "description": "Intelligent sub-agent orchestration for DeepSeek Harness, with model discovery, routing, planning, and parallel delegation.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "subagent",
    "orchestration",
    "multi-agent"
  ],
  "homepage": "https://github.com/yejianming88888-ctrl/dsh-samrt-subagent#readme",
  "bugs": {
    "url": "https://github.com/yejianming88888-ctrl/dsh-samrt-subagent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yejianming88888-ctrl/dsh-samrt-subagent.git"
  },
  "author": "yejianming88888-ctrl",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --check lib/index.js && node --check lib/client.js && node --test",
    "prepack": "pnpm test"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
